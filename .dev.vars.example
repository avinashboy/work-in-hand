# Set on Cloudflare with `npx wrangler secret put <NAME>`.

# The login password, at least 12 characters. `npm run dev` skips the login.
# Without it, a deployed site lets nobody in.
APP_PASSWORD=

# The key outside apps send to the API (docs/API.md), at least 32 characters.
# Without it, every API call is refused.
API_KEY=
